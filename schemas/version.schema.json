{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/SorcerioTheWizard/CCPM-Registry/master/schemas/version.schema.json",
    "title": "CCPM Package Version",
    "description": "One published version of a package, stored as `packages/<name>/<version>.json`. Published versions must never change.",
    "type": "object",
    "additionalProperties": false,
    "required": ["kind"],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "kind": {
            "description": "`files` installs the listed files and tracks them. `installer` runs a command that installs the package itself, so its files cannot be tracked.",
            "enum": ["files", "installer"]
        },
        "files": {
            "description": "The files to install.",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["url", "path", "sha256"],
                "properties": {
                    "url": {
                        "description": "A raw text URL pinned to this exact file content, on an allowed host.",
                        "type": "string",
                        "pattern": "^https://"
                    },
                    "path": {
                        "description": "Where to install the file, relative to the CCPM root: `bin/<program>.lua`, `lib/<package>.lua`, `lib/<package>/...`, or `share/<package>/...`.",
                        "type": "string"
                    },
                    "sha256": {
                        "description": "The lowercase SHA-256 of the exact bytes served by `url`.",
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    }
                }
            }
        },
        "installer": {
            "description": "The shell command that installs the package.",
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
                "command": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "dependencies": {
            "description": "Packages this version needs, mapped to the version ranges it accepts.",
            "type": "object",
            "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "additionalProperties": {
                "type": "string"
            }
        },
        "compat": {
            "description": "The ComputerCraft and Minecraft versions this version works on, as version ranges.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cc": {
                    "type": "string"
                },
                "mc": {
                    "type": "string"
                }
            }
        },
        "startup": {
            "description": "A `bin/` file from `files` to run when the computer boots.",
            "type": "string"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": { "kind": { "const": "files" } }
            },
            "then": {
                "required": ["files"],
                "not": { "required": ["installer"] }
            }
        },
        {
            "if": {
                "properties": { "kind": { "const": "installer" } }
            },
            "then": {
                "required": ["installer"],
                "not": {
                    "anyOf": [{ "required": ["files"] }, { "required": ["startup"] }]
                }
            }
        }
    ]
}
